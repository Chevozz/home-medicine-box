datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                 String           @id @default(uuid())
  name               String
  email              String           @unique
  password_hash      String
  reset_token        String?
  reset_token_expiry DateTime?
  created_at         DateTime         @default(now())
  updated_at         DateTime         @updatedAt
  medicines          Medicine[]
  logs               ConsumptionLog[]
  userSchedules      UserSchedule[]
}

model Medicine {
  id                  String           @id @default(uuid())
  user_id             String
  name                String
  type                String
  dosage_instructions String
  stock_quantity      Int
  expiry_date         DateTime
  created_at          DateTime         @default(now())
  updated_at          DateTime         @updatedAt

  user         User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  schedules    Schedule[]
  logs         ConsumptionLog[]
  userSchedules UserSchedule[]
}

model Schedule {
  id           String   @id @default(uuid())
  medicine_id  String
  time_to_take String
  frequency    String
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  medicine Medicine @relation(fields: [medicine_id], references: [id], onDelete: Cascade)
  logs     ConsumptionLog[]
}

model UserSchedule {
  id           String   @id @default(uuid())
  user_id      String
  medicine_id  String
  name         String
  time_to_take String
  recurrence   String
  days_of_week String?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  user     User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  medicine Medicine @relation(fields: [medicine_id], references: [id], onDelete: Cascade)
}

model ConsumptionLog {
  id          String   @id @default(uuid())
  user_id     String
  medicine_id String
  schedule_id String?
  consumed_at DateTime @default(now())
  status      String
  created_at  DateTime @default(now())

  user     User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  medicine Medicine @relation(fields: [medicine_id], references: [id], onDelete: Cascade)
  schedule Schedule? @relation(fields: [schedule_id], references: [id], onDelete: SetNull)
}
